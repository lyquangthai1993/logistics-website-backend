NODE_ENV=production
APP_PORT=3001
APP_NAME="Logistics TMS API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang

# Thay bằng domain thật của VM (sau khi có)
BACKEND_DOMAIN=https://api.yourdomain.com
FRONTEND_DOMAIN=https://your-app.vercel.app
APP_CORS_ORIGINS=https://your-app.vercel.app

# Neon PostgreSQL (giữ nguyên từ local)
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://...
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=20
DATABASE_SSL_ENABLED=true
DATABASE_REJECT_UNAUTHORIZED=false

# Supabase Storage (điền từ Phase 1)
FILE_DRIVER=s3
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=ap-southeast-1
AWS_DEFAULT_S3_BUCKET=logistics-media
AWS_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3

# Redis (internal Docker network — không cần password nếu không expose ra ngoài)
WORKER_HOST=redis://redis:6379/1

# JWT — Đổi thành chuỗi random mạnh (dùng: openssl rand -base64 64)
AUTH_JWT_SECRET=
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=true

# Mail (có thể để trống nếu không dùng cho demo)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=noreply@yourdomain.com
MAIL_DEFAULT_NAME=LogisticsTMS
