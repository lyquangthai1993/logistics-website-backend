# ─── Stage 1: Builder ────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --ignore-scripts

COPY . .
RUN npm run build

# ─── Stage 2: Runner ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runner

WORKDIR /app

# Install production dependencies only
COPY package*.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Copy compiled output from builder
COPY --from=builder /app/dist ./dist

# Copy i18n translation files
COPY --from=builder /app/src/i18n ./src/i18n

# Copy mail templates files
COPY --from=builder /app/src/mail/mail-templates ./src/mail/mail-templates

# Copy and prepare startup script
COPY startup.prod.sh ./startup.prod.sh
RUN chmod +x ./startup.prod.sh

EXPOSE 3001

CMD ["sh", "./startup.prod.sh"]
